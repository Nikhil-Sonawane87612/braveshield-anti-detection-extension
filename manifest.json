{
  "manifest_version": 3,
  "name": "BraveShield Bypass Pro — Enterprise Stealth & Anti-Fingerprinting",
  "version": "6.2.0",
  "description": "Enterprise Manifest V3 anti-fingerprinting suite with unforgeable native wrappers, session-seeded canvas/audio noise, WebGL GPU cloaking, UA-CH client hints sync, and WebRTC leak protection.",
  "author": "Nikhil Sonawane",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "tabs",
    "alarms",
    "privacy",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/constants.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared/constants.js", "hardware-profiles.js", "inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "rules.json", "hardware-profiles.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-master-shield": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Toggle the BraveShield master shield"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}

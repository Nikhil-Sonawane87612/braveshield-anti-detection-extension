[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        { "header": "Sec-CH-UA-Brave", "operation": "remove" },
        { "header": "X-Brave-Tracking", "operation": "remove" },
        { "header": "Sec-CH-UA-Model", "operation": "remove" }
      ]
    },
    "condition": {
      "urlFilter": "*",
      "resourceTypes": ["main_frame", "sub_frame", "stylesheet", "script", "image", "xmlhttprequest", "font", "media", "websocket"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "X-Brave-Shields", "operation": "remove" }
      ]
    },
    "condition": {
      "urlFilter": "*",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 3,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": [
              "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "utm_id",
              "fbclid", "gclid", "gclsrc", "dclid", "wbraid", "gbraid", "mc_eid", "igshid", "msclkid", "yclid"
            ]
          }
        }
      }
    },
    "condition": {
      "urlFilter": "*",
      "resourceTypes": ["main_frame", "sub_frame"]
    }
  }
]
